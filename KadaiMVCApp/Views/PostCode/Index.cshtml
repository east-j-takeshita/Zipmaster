@{

}
<link rel="stylesheet" href="https://cdn.bootcss.com/bootstrap/3.3.5/css/bootstrap.css">

<div id="index" class="text-left">
    <h1 class="display-3">{{ title }}</h1>
    <form>
        @* asp-controller="PostCode" asp-action="Index" *@
        @* 送信先のコントローラー名、送信先のアクション指定 *@
        <div class="form-group">
            <label for="postcode">郵便番号</label>
            <input type="text" name="postcode" id="postcode" class="form-control" placeholder="検索したい郵便番号を入力して検索してください" v-model="searchPostCode" />@* v-model="searchData.keyPostCode" *@
            <label for="keyword">キーワード検索欄</label>
            <input type="text" name="keyword" id="keyword" class="form-control" placeholder="検索したいキーワードを入力して検索してください" v-model="searchKeyWord" />

        </div>
        <div class="form-group">
            <button v-on:click="getZipData" type="button" class="btn btn-primary">送信</button>
        </div>
    </form>

    <p v-if="zipsData===null">該当データはありません</p>
    @* <table class="table">
    <tr>
    <th>郵便番号</th>
    <th>都道府県名</th>
    <th>市区町村名</th>
    <th>町域名</th>
    <th>詳細リンク</th>

    </tr>

    <tr v-for="zip in zipsData" :key="zip.id">
    <td>{{zip.postCode}}</td>
    <td>{{zip.prefecture}}</td>
    <td>{{zip.city}}</td>
    <td>{{zip.shipToAddress}}</td>
    <td><a v-bind:href="url+zip.postOrderID">詳細はこちら</a></td>
    </tr>

    </table> *@
    <button type="submit" class="btn btn-primary" onclick="location.href='PostCode/Create'" value="遷移">新規追加</button>
    @* <ul>
    <li><button v-on:click="sort(1)">郵便番号昇順</button></li>
    <li><button v-on:click="sort(2)">郵便番号降順</button></li>
    </ul> *@

    <div v-if="zipsData!==null">
        <table class="table">
            <tr>
                <th class="postcode-header">
                    郵便番号
                    <div class="sort-button">
                        <span v-if="sortOrder==0||sortOrder==2" v-on:click="sort(1)">▲</span>
                        <span v-if="sortOrder==0||sortOrder==1" v-on:click="sort(2)">▼</span>
                    </div>
                </th>


                <th>都道府県名</th>
                <th>市区町村名</th>
                <th>町域名</th>
                <th>詳細リンク</th>

            </tr>
            <tr v-for="zip in getLists" :key="zip.postOrderID">
                <td>{{zip.postCode}}</td>
                <td>{{zip.prefecture}}</td>
                <td>{{zip.city}}</td>
                <td>{{zip.shipToAddress}}</td>
                <td><a v-bind:href="url+zip.postOrderID">詳細はこちら</a></td>
            </tr>
        </table>

        <ul class="pagination">
            <li v-if="hasThreePage&&hasPreviousPage" v-on:click=" getToFirstPage"><a>&laquo</a></li>
            <li v-if="hasThreePage&&hasPreviousPage" v-on:click=" getToPreviousPage"><a>&lt;</a></li>
            @* 3ページ以上あるとき、かつ、最後のページの時だけ *@
            <li v-if="(hasThreePage)&&(currentPage==getPageCount)" v-on:click="getToPreviousPage"><a>{{subPreviousPage}}</a></li>
            <li v-if="hasPreviousPage" v-on:click="getToPreviousPage"><a>{{previousPage}}</a></li>
            <li v-on:click="" class=""><a style="background-color:skyblue">{{currentPage}}</a></li>
            <li v-if="hasNextPage" v-on:click="getToNextPage"><a>{{nextPage}}</a></li>
            @* 3ページ目があるとき、かつ、最初のページの時だけ *@
            <li v-if="(hasThreePage)&&(currentPage==1)" v-on:click="getToSubNextPage"><a>{{subNextPage}}</a></li>
            <li v-if="hasThreePage&&hasNextPage" v-on:click=" getToNextPage"><a>&gt</a></li>
            <li v-if="hasThreePage&&hasNextPage" v-on:click=" getToLastPage"><a>&raquo</a></li>
        </ul>

    </div>







</div>

<!-- or use the specify version -->
<script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/vuejs-paginate-next@latest/dist/vuejs-paginate-next.umd.js"></script>
@* //<script src="~/js/app.mjs" type = 'module' defer></script> *@


<script type="module">
    import { createApp, ref, computed} from "https://unpkg.com/vue@3/dist/vue.esm-browser.js";


    const app = createApp({
        setup() {
            const title = ref('検索Vue');
            const url = ref('PostCodeDetail/');

            const searchPostCode = ref();
            const searchKeyWord = ref();
            const zipsData = ref(null);


            // データ取得
            const getZipData = async () => {
                try {
                    const config = {
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                            'Content-Type': 'application/x-www-form-urlencoded'
                        }
                    };

                    const response = await axios.post('Index/' + searchPostCode.value + '/' + searchKeyWord.value);//APIと合わせる

                    //console.log(response);
                    zipsData.value = response.data.zipsData;//取ってきたデータ格納。zipsDataにはいろいろ入っているので、valueをつける。
                    getToFirstPage();
                    sortOrder.value = 0;
                }
                catch (err) {
                    console.error(err);
                }
            };



            // ページング
            const subPreviousPage = ref(0);
            const previousPage = ref(0);//前のページ数
            const currentPage = ref(1);// 現在のページ
            const nextPage = ref(2);//次のページ数
            const subNextPage = ref(3);
            const parPage = ref(10);// 1ページに表示する件数
            const sortOrder = ref(0);// ソートの基準を設定する変数


            const getLists = computed(() => {
                
                const current = currentPage.value * parPage.value;//現在の表示の最後
                const start = current - parPage.value;//0からスタート
                return sortedItems.value.slice(start, current);//0-10zipsDataからsortedItemsに変更
            });//そのページに合ったデータだけを表示 1ページ目ならtweetsの0〜9番目を、2ページ目なら10〜19番目のデータを表示

            const getPageCount = computed(() => {
                return zipsData.value ? Math.ceil(zipsData.value.length / parPage.value) : null;//10/3の時4
            });//総ページの計算を最初だけ



            const getToFirstPage = () => {
                previousPage.value = 0;
                currentPage.value = 1;
                nextPage.value = 2;
   
            };//開始ページに行く。呼び出せるときはHTMLでv-ifで指定

            const getToPreviousPage = () => {
                previousPage.value -= 1;
                currentPage.value -= 1;
                nextPage.value -= 1;
            };//1ページ前に行く。呼び出せるときはHTMLでv-ifで指定

            const getToNextPage = () => {
                previousPage.value += 1;
                currentPage.value += 1;
                nextPage.value += 1;
                subPreviousPage.value = currentPage.value - 2;
            };//1ページ後に行く。呼び出せるときはHTMLでv-ifで指定

            const getToSubNextPage = () => {
                previousPage.value += 2;
                currentPage.value += 2;
                nextPage.value += 2; 
            };//2ページ後に行く。呼び出せるときはHTMLでv-ifで指定

            const getToLastPage = () => {
                currentPage.value = getPageCount.value;//getPageCount最後の値を入れる
                subPreviousPage.value = currentPage.value - 2;
                previousPage.value = currentPage.value - 1;
                nextPage.value = currentPage.value + 1;//使わないが代入
            };//最終ページに行く。呼び出せるときはHTMLでv-ifで指定


            //前後のページがあるかどうか確認
            const hasPreviousPage = computed(() =>currentPage.value > 1);//前
            const hasNextPage = computed(() => currentPage.value < getPageCount.value);//後ろ
            const hasThreePage = computed(() => getPageCount.value >= 3 );//3ページ目があるかどうか


            // ソート
            // ソート関数
            function sort(index) {
                sortOrder.value = index;//0は何もなし、1は昇順、2は降順
                console.log(sortOrder.value);//反応している
            }

            const sortedItems = computed(() => {
                // データの深いコピーを作成
                // ソートの順序を決定
                switch (sortOrder.value) {
                    case 1: // 昇順
                        return zipsData.value.sort((a, b) => parseInt(a.postCode) - parseInt(b.postCode));
                    case 2: // 降順
                        return zipsData.value.sort((a, b) => parseInt(b.postCode) - parseInt(a.postCode));
                    default: // ソートしない
                        return zipsData.value;
                }
            });



            return {
                title,
                searchPostCode,
                searchKeyWord,
                url,
                getZipData,
                zipsData,



                //parPage,表示側で使うやつだけ返せばよい
                getLists,
                //getPageCount,
                subPreviousPage,
                previousPage,
                currentPage,
                nextPage,
                subNextPage,

                hasPreviousPage,
                hasNextPage,
                hasThreePage,
                //changePage,
                getPageCount,
                getToFirstPage,
                getToPreviousPage,
                getToNextPage,
                getToSubNextPage,
                getToLastPage,//ページング

                sort,
                sortedItems,
                sortOrder//ソート
            };

        }



    });

    app.mount('#index');


    //app.component('paginate', Paginate);


</script>

